---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import FormField from "../components/FormField.astro";

const today = new Date().toISOString().split("T")[0];
---

<Layout title="Agendar Cita - Kone's">
  <Header />

  <main class="min-h-screen bg-bg px-4 py-12 transition-colors duration-300">
    <form
      method="POST"
      class="mx-auto flex max-w-md flex-col gap-5 rounded-3xl border border-line bg-card p-8 shadow-card transition-colors duration-300"
    >
      <h2 class="mb-2 text-center text-2xl font-bold text-ink">
        Agendar una cita
      </h2>

      <FormField id="tutor" label="Nombre del tutor" placeholder="Ej. María López" />
      <FormField id="child" label="Nombre del niño o niña" placeholder="Ej. Mateo" />
      <FormField id="email" label="Correo electrónico" type="email" placeholder="ejemplo@correo.com" />
      <FormField id="phone" label="Teléfono de contacto" type="tel" placeholder="123 456 7890" />
      <FormField id="date" label="Fecha de la cita" type="date" min={today} />

      <button
        type="submit"
        class="mt-3 w-full cursor-pointer rounded-full bg-brand px-6 py-3.5 text-center font-bold text-ink shadow-md transition-all duration-200 hover:bg-brand-dark hover:shadow-lg active:scale-95"
      >
        Solicitar cita
      </button>
    </form>
  </main>
</Layout>
