---
import Layout from "../layouts/Layout.astro"; 
import Header from "../components/Header.astro";
---

<Layout title="Agendar Cita - Kone's">
  <Header />
  
  <!-- Envoltura principal con soporte para modo oscuro (dark:bg-gray-900) -->
  <main class="min-h-screen bg-white dark:bg-gray-900 transition-colors duration-300 py-12 px-4">
    <form class="max-w-md mx-auto p-8 bg-white dark:bg-gray-800 rounded-3xl shadow-lg border border-gray-100 dark:border-gray-700 flex flex-col gap-5 transition-colors duration-300">
      
      <h2 class="text-2xl font-bold text-center text-gray-800 dark:text-white mb-2">
        Agendar una cita
      </h2>

      <!-- Nombre del tutor -->
      <div class="flex flex-col gap-1.5">
        <label for="tutor" class="text-sm font-semibold text-gray-700 dark:text-gray-200">
          Nombre del tutor
        </label>
        <input 
          id="tutor"
          name="tutor"
          type="text" 
          required
          placeholder="Ej. María López" 
          class="w-full px-4 py-3 rounded-2xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-white placeholder-gray-400 dark:placeholder-gray-400 focus:bg-white dark:focus:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-lime-400 focus:border-transparent transition-all"
        />
      </div>

      <!-- Nombre del niño o niña -->
      <div class="flex flex-col gap-1.5">
        <label for="child" class="text-sm font-semibold text-gray-700 dark:text-gray-200">
          Nombre del niño o niña
        </label>
        <input 
          id="child"
          name="child"
          type="text" 
          required
          placeholder="Ej. Mateo" 
          class="w-full px-4 py-3 rounded-2xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-white placeholder-gray-400 dark:placeholder-gray-400 focus:bg-white dark:focus:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-lime-400 focus:border-transparent transition-all"
        />
      </div>

      <!-- Correo electrónico -->
      <div class="flex flex-col gap-1.5">
        <label for="email" class="text-sm font-semibold text-gray-700 dark:text-gray-200">
          Correo electrónico
        </label>
        <input 
          id="email"
          name="email"
          type="email" 
          required
          placeholder="ejemplo@correo.com" 
          class="w-full px-4 py-3 rounded-2xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-white placeholder-gray-400 dark:placeholder-gray-400 focus:bg-white dark:focus:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-lime-400 focus:border-transparent transition-all"
        />
      </div>

      <!-- Teléfono de contacto -->
      <div class="flex flex-col gap-1.5">
        <label for="phone" class="text-sm font-semibold text-gray-700 dark:text-gray-200">
          Teléfono de contacto
        </label>
        <input 
          id="phone"
          name="phone"
          type="tel" 
          required
          placeholder="123 456 7890" 
          class="w-full px-4 py-3 rounded-2xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-white placeholder-gray-400 dark:placeholder-gray-400 focus:bg-white dark:focus:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-lime-400 focus:border-transparent transition-all"
        />
      </div>

      <!-- Fecha de la cita -->
      <div class="flex flex-col gap-1.5">
        <label for="date" class="text-sm font-semibold text-gray-700 dark:text-gray-200">
          Fecha de la cita
        </label>
        <input 
          id="date"
          name="date"
          type="date" 
          required
          class="w-full px-4 py-3 rounded-2xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-white placeholder-gray-400 dark:placeholder-gray-400 focus:bg-white dark:focus:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-lime-400 focus:border-transparent transition-all [color-scheme:light] dark:[color-scheme:dark]"
        />
      </div>

      <!-- Botón Submit -->
      <button 
        type="submit" 
        class="mt-3 w-full py-3.5 px-6 bg-[#65D836] hover:bg-[#52c227] text-white font-bold rounded-full shadow-md hover:shadow-lg transition-all duration-200 active:scale-95 text-center cursor-pointer"
      >
        Solicitar cita
      </button>
    </form>
  </main>
</Layout>