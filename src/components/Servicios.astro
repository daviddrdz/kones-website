---
import { servicesData } from '../data/siteData';
---
<section id="servicios" class="py-12 bg-gray-50">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl font-bold text-center mb-8 text-gray-800">Nuestros Servicios</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {servicesData.map((service) => (
        <article class="bg-white p-6 rounded-lg shadow-sm hover:shadow-md transition-shadow border border-gray-100">
          <h3 class="text-xl font-semibold mb-3 text-blue-700">{service.title}</h3>
          <p class="text-gray-600 leading-relaxed">{service.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
