---
const fotos = [
  { src: "/img/instalaciones-1.jpg", alt: "Sala principal de terapia" },
  { src: "/img/instalaciones-2.jpg", alt: "Área de juegos" },
  { src: "/img/instalaciones-3.jpg", alt: "Espacio de lectura" },
  { src: "/img/instalaciones-4.jpg", alt: "Consultorio" },
  { src: "/img/instalaciones-5.jpg", alt: "Sala de espera" },
];
---

<section
  id="instalaciones"
  class="bg-linear-to-b from-bg to-hero-end scroll-mt-20 px-[5%] pb-16 pt-12 text-center"
>
  <h2 class="mb-8 text-[0.95rem] font-medium tracking-[0.25em]">INSTALACIONES</h2>

  <div class="mx-auto grid max-w-275 grid-cols-2 gap-3 md:grid-cols-4 md:grid-rows-2 md:gap-4">
    {
      fotos.map((foto, i) => (
        <figure
          class:list={[
            "overflow-hidden rounded-[20px] bg-card shadow-card",
            i === 0
              ? "col-span-2 aspect-4/3 md:row-span-2 md:aspect-auto"
              : "aspect-square",
          ]}
        >
          <img
            src={foto.src}
            alt={foto.alt}
            loading="lazy"
            class="size-full object-cover transition-transform duration-300 hover:scale-105"
          />
        </figure>
      ))
    }
  </div>
</section>
