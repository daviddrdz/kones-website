---
import { navLinks } from '../data/siteData';
---
<header class="bg-white shadow-md py-4 sticky top-0 w-full z-50">
  <nav class="container mx-auto flex justify-between items-center px-4">
    <a href="/" class="text-xl font-bold text-blue-600">Kone's</a>
    <ul class="flex gap-6">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="text-gray-700 hover:text-blue-600 transition-colors">
            {link.name}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

