---
import Button from "./Button.astro";
import ThemeToggle from "./ThemeToggle.astro";

const links = [
  { href: "#inicio", label: "Inicio" },
  { href: "#servicios", label: "Servicios" },
  { href: "#instalaciones", label: "Instalaciones" },
  { href: "#actividades", label: "Actividades" },
];
---

<header
  class="sticky top-0 z-[100] flex items-center justify-between gap-4 bg-bg/90 text-ink px-[5%] py-[0.8rem] backdrop-blur-sm transition-colors duration-300 max-sm:flex-wrap max-sm:justify-center max-sm:gap-y-2"
>
  <a href="#inicio" class="flex shrink-0 items-center">
    <img src="/logo.png" alt="Kone's" class="h-[75px] w-[200px] object-contain" />
  </a>

  <nav class="flex items-center gap-[1.8rem] max-sm:order-3 max-sm:w-full max-sm:justify-center max-sm:gap-[1.1rem]">
    {
      links.map((link) => (
        <a
          href={link.href}
          class="relative text-[0.85rem] font-medium text-ink dark:text-white transition-colors duration-200 hover:text-brand-dark after:absolute after:-bottom-1 after:left-0 after:h-0.5 after:w-0 after:rounded-sm after:bg-brand after:transition-[width] after:duration-300 after:content-[''] hover:after:w-full"
        >
          {link.label}
        </a>
      ))
    }
  </nav>

  <div class="flex items-center gap-3">
    <Button href="/form" class="!px-[1.3rem] !py-[0.55rem] !text-[0.85rem]">
      Agendar cita
    </Button>

    <ThemeToggle />
  </div>
</header>