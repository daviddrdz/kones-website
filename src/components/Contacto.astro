---
import { Icon } from "astro-icon/components";

const contactos = [
  {
    title: "Whatsapp",
    icon: "tabler:phone-filled",
    color: "text-[#5ce1e6]",
    href: "https://wa.me/523318729237",
    lines: ["(+52) 33-18-72-92-37"],
    external: true,
  },
  {
    title: "Ubicación",
    icon: "tabler:map-pin-filled",
    color: "text-[#c9e265]",
    href: "https://maps.app.goo.gl/SaTGmnkNiRip5QKB8",
    lines: ["Vasco de Quiroga, La Loma,", "44410 Guadalajara, Jal."],
    external: true,
  },
  {
    title: "Correo",
    icon: "tabler:device-laptop",
    color: "text-[#ffde59]",
    href: "mailto:contacto@kones.com.mx",
    lines: ["contacto@kones.com.mx"],
  },
];
---

<section id="contacto" class="scroll-mt-20 bg-bg px-[5%] pb-16 pt-8 text-center">
  <h2 class="mb-8 text-[0.95rem] font-medium tracking-[0.25em]">CONTACTO</h2>

  <div class="mx-auto grid max-w-275 grid-cols-1 gap-8 md:grid-cols-3">
    {
      contactos.map((c) => {
        const Tag = c.href ? "a" : "div";
        return (
          <Tag
            href={c.href}
            target={c.external ? "_blank" : undefined}
            rel={c.external ? "noopener noreferrer" : undefined}
            class="group flex flex-col items-center px-2 py-4 transition-transform duration-300 hover:-translate-y-1.5"
          >
            <div class="mb-4 flex size-25 items-center justify-center rounded-full bg-card shadow-card">
              <Icon name={c.icon} class:list={["size-12", c.color]} />
            </div>
            <h3 class="mb-[0.6rem] text-[0.95rem] font-semibold leading-[1.3] text-ink">
              {c.title}
            </h3>
            {c.lines.map((line) => (
              <p class="text-[0.95rem] leading-relaxed text-soft transition-colors duration-200 group-hover:text-ink">
                {line}
              </p>
            ))}
          </Tag>
        );
      })
    }
  </div>
</section>
