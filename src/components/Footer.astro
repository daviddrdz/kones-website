---
import { Icon } from "astro-icon/components";

const socialLinks = [
  { name: "Facebook", href: "https://www.facebook.com/Konesmx", icon: "tabler:brand-facebook" },
  { name: "Instagram", href: "https://www.instagram.com/konesmx", icon: "tabler:brand-instagram" },
  { name: "X", href: "https://x.com/konesmx", icon: "tabler:brand-x" },
  { name: "Pinterest", href: "https://www.pinterest.com/Konesmx/", icon: "tabler:brand-pinterest" },
];

const navLinks = [
  { name: "Inicio", href: "#" },
  { name: "Servicios", href: "#servicios" },
  { name: "Nosotros", href: "#nosotros" },
  { name: "Contacto", href: "#contacto" },
];
---

<footer class="bg-bg text-ink border-t border-line px-[5%] pb-8 pt-12">
  <div class="mx-auto flex max-w-275 flex-col items-center gap-10 min-[769px]:flex-row min-[769px]:items-start min-[769px]:justify-between">

    <!-- Branding e Información -->
    <div class="flex flex-col items-center text-center min-[769px]:items-start min-[769px]:text-left max-w-75">
      <h3 class="mb-3 text-[1.1rem] font-bold tracking-widest uppercase">
        KONE'S
      </h3>
      <p class="text-[0.85rem] text-soft leading-relaxed mb-4">
        Acompañamos el aprendizaje y desarrollo integral de habilidades de manera personalizada.
      </p>
      
      <!-- Datos de contacto rápidos -->
      <ul class="flex flex-col gap-2 text-[0.8rem] text-soft">
        <li class="flex items-center gap-2 justify-center min-[769px]:justify-start">
          <Icon name="tabler:mail" class="size-4 shrink-0" />
          <span>contacto@kones.com.mx</span>
        </li>
        <li class="flex items-center gap-2 justify-center min-[769px]:justify-start">
          <Icon name="tabler:phone" class="size-4 shrink-0" />
          <span>+52 1 33 1872 9237</span>
        </li>
      </ul>
    </div>

    <!-- Navegación -->
    <div class="flex flex-col items-center text-center min-[769px]:items-start min-[769px]:text-left">
      <h4 class="mb-4 text-[0.9rem] font-semibold tracking-[0.15em] uppercase">
        Enlaces
      </h4>
      <ul class="flex flex-col gap-2 text-[0.85rem] text-soft">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="transition-colors duration-200 hover:text-text"
              >
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Redes Sociales -->
    <div class="flex flex-col items-center text-center min-[769px]:items-start min-[769px]:text-left">
      <h4 class="mb-4 text-[0.9rem] font-semibold tracking-[0.15em] uppercase">
        Síguenos
      </h4>
      <div class="flex gap-3">
        {
          socialLinks.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex size-10 items-center justify-center rounded-full bg-card text-ink shadow-card transition-transform duration-300 hover:-translate-y-1 hover:shadow-md"             aria-label={social.name}
            >
              <Icon name={social.icon} class="size-5" />
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Copyright -->
  <div class="mx-auto mt-12 max-w-275 border-t border-black/5 pt-6 text-center text-[0.75rem] text-soft">
    <p>© {new Date().getFullYear()} Kone's. Todos los derechos reservados.</p>
  </div>
</footer>

