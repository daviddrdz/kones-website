---
import Button from "./Button.astro";
---

<section
  id="inicio"
  class="flex flex-col items-center bg-gradient-to-b from-bg to-hero-end px-[5%] pb-12 pt-6 text-center"
>
  <img
    src="/img/hero.png"
    alt="Niños leyendo, jugando con bloques y dibujando bajo un arcoíris"
    class="mb-6 h-auto w-full max-w-[560px]"
  />

  <h1 class="mb-[1.4rem] text-[clamp(1.6rem,4vw,2.6rem)] font-bold">
    ¡Bienvenida@ a Kone's!
  </h1>

  <div class="flex flex-wrap items-center justify-center gap-[0.8rem] max-sm:w-full max-sm:flex-col">
    <Button
      href="#servicios"
      variant="secondary"
      class="!px-[1.8rem] !py-[0.85rem] max-sm:w-full max-sm:max-w-[320px]"
    >
      Conoce nuestros servicios
    </Button>
    <Button
      href="#agendar"
      class="!px-[1.8rem] !py-[0.85rem] max-sm:w-full max-sm:max-w-[320px]"
    >
      Agendar cita
    </Button>
  </div>
</section>
